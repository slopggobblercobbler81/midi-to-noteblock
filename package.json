{
  "name": "midi-to-noteblock",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Pure client-side web application converting MIDI files into playable Minecraft note block schematics with an interactive audio preview",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "pretest": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.7.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
